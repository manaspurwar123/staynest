<% layout("layouts/boilerplate") %>
    <% if (listing) { %>
        <div class="row mt-3">
            <div class="col-8 offset-3">
                <h3>Listing Details :</h3>
            </div>
            <div class="col-10 offset-1">
                <div class="show-booking-layout">
                    <div class="listing-main-panel">
                        <div class="card show-card listing-card">
                            <div class="image-shell show-image-shell is-loading">
                                <img src="<%= listing.image %>" class="card-img-top show-img js-managed-image" alt="<%= listing.title %>" loading="eager" decoding="async" fetchpriority="high" data-fallback-src="/images/stay-placeholder.svg">
                            </div>
                            <div class="card-body">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b><br>
                                    <%= listing.description %><br>
                                        <span class="listing-category"><%= listing.category || 'Rooms' %></span><br>
                                        &#8377; <%= typeof listing.price==='number' ? listing.price.toLocaleString("en-IN") :
                                            listing.price %> / night<br>
                                            <%= listing.location %><br>
                                                <%= listing.country %>
                                </p>
                            </div>
                        </div>
                        <div class="btns listing-action-btns gap-3">
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger edit-btn">Edit</a>
                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                <button class="btn btn-dark">Delete</button>
                            </form>
                        </div>
                    </div>
                    <aside class="booking-card">
                        <div class="booking-price">
                            <b>&#8377; <%= typeof listing.price==='number' ? listing.price.toLocaleString("en-IN") : listing.price %></b>
                            <span>/ night</span>
                        </div>
                        <div class="booking-action-tabs" role="tablist" aria-label="Stay actions">
                            <button class="booking-tab-btn active" id="reserve-tab" data-bs-toggle="tab" data-bs-target="#reserve-panel" type="button" role="tab" aria-controls="reserve-panel" aria-selected="true">
                                <i class="fa-regular fa-calendar-check"></i>
                                Reserve
                            </button>
                            <button class="booking-tab-btn" id="wishlist-tab" data-bs-toggle="tab" data-bs-target="#wishlist-panel" type="button" role="tab" aria-controls="wishlist-panel" aria-selected="false">
                                <i class="fa-regular fa-heart"></i>
                                Save
                            </button>
                            <button class="booking-tab-btn" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact-panel" type="button" role="tab" aria-controls="contact-panel" aria-selected="false">
                                <i class="fa-regular fa-paper-plane"></i>
                                Contact
                            </button>
                        </div>
                        <div class="booking-card-actions tab-content">
                            <form method="POST" action="/listings/<%= listing._id %>/bookings" class="booking-form tab-pane fade show active" id="reserve-panel" role="tabpanel" aria-labelledby="reserve-tab">
                                <div class="booking-form-grid">
                                    <label>
                                        <span>Check in</span>
                                        <input name="booking[checkIn]" type="date" required>
                                    </label>
                                    <label>
                                        <span>Check out</span>
                                        <input name="booking[checkOut]" type="date" required>
                                    </label>
                                </div>
                                <label>
                                    <span>Guests</span>
                                    <input name="booking[guests]" type="number" min="1" value="1" required>
                                </label>
                                <label>
                                    <span>Name</span>
                                    <input name="booking[guestName]" type="text" placeholder="Your full name" required>
                                </label>
                                <label>
                                    <span>Email</span>
                                    <input name="booking[guestEmail]" type="email" placeholder="you@example.com" required>
                                </label>
                                <button class="booking-reserve-btn" type="submit">
                                    <i class="fa-regular fa-calendar-check"></i>
                                    Reserve now
                                </button>
                            </form>
                            <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="wishlist-save-form tab-pane fade" id="wishlist-panel" role="tabpanel" aria-labelledby="wishlist-tab">
                                <h4>Save to wishlist</h4>
                                <label>
                                    <span>Note</span>
                                    <input name="wishlist[note]" type="text" maxlength="160" placeholder="Add a note">
                                </label>
                                <button class="wishlist-save-btn" type="submit">
                                    <i class="fa-regular fa-heart"></i>
                                    Save
                                </button>
                            </form>
                            <form method="POST" action="/listings/<%= listing._id %>/inquiries" class="inquiry-form tab-pane fade" id="contact-panel" role="tabpanel" aria-labelledby="contact-tab">
                                <h4>Contact host</h4>
                                <div class="inquiry-form-grid">
                                    <label>
                                        <span>Name</span>
                                        <input name="inquiry[guestName]" type="text" placeholder="Your name" required minlength="2">
                                    </label>
                                    <label>
                                        <span>Email</span>
                                        <input name="inquiry[guestEmail]" type="email" placeholder="you@example.com" required>
                                    </label>
                                </div>
                                <label>
                                    <span>Phone</span>
                                    <input name="inquiry[phone]" type="tel" placeholder="Optional">
                                </label>
                                <label>
                                    <span>Message</span>
                                    <textarea name="inquiry[message]" rows="3" placeholder="Ask about this stay" required minlength="10" maxlength="1000"></textarea>
                                </label>
                                <button class="inquiry-send-btn" type="submit">
                                    <i class="fa-regular fa-paper-plane"></i>
                                    Send inquiry
                                </button>
                            </form>
                        </div>
                    </aside>
                </div>
            </div>

            <% if (false) { %>
            <div class="col-10 offset-1 mt-4">
                <section class="guest-action-panel guest-action-panel-hidden">
                    <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="wishlist-save-form">
                        <div>
                            <h4>Save this stay</h4>
                            <p>Add a private note for your wishlist.</p>
                        </div>
                        <label>
                            <span>Wishlist note</span>
                            <input name="wishlist[note]" type="text" maxlength="160" placeholder="Why save this stay?">
                        </label>
                        <button class="wishlist-save-btn" type="submit">
                            <i class="fa-regular fa-heart"></i>
                            Save
                        </button>
                    </form>
                    <form method="POST" action="/listings/<%= listing._id %>/inquiries" class="inquiry-form">
                        <h4>Contact host</h4>
                        <div class="inquiry-form-grid">
                            <label>
                                <span>Name</span>
                                <input name="inquiry[guestName]" type="text" placeholder="Your name" required minlength="2">
                            </label>
                            <label>
                                <span>Email</span>
                                <input name="inquiry[guestEmail]" type="email" placeholder="you@example.com" required>
                            </label>
                        </div>
                        <label>
                            <span>Phone</span>
                            <input name="inquiry[phone]" type="tel" placeholder="Optional">
                        </label>
                        <label>
                            <span>Message</span>
                            <textarea name="inquiry[message]" rows="3" placeholder="Ask about availability, house rules or anything else." required minlength="10" maxlength="1000"></textarea>
                        </label>
                        <button class="inquiry-send-btn" type="submit">
                            <i class="fa-regular fa-paper-plane"></i>
                            Send inquiry
                        </button>
                    </form>
                </section>
            </div>
            <% } %>

            <div class="col-10 offset-1 mt-5">
                <% const mapAddress = `${listing.location}, ${listing.country}`; %>
                <% const mapQuery = encodeURIComponent(mapAddress); %>
                <section class="listing-location-section">
                    <div class="listing-location-header">
                        <div>
                            <h3>Where you'll be</h3>
                            <p><i class="fa-solid fa-location-dot"></i> <%= mapAddress %></p>
                        </div>
                        <a class="map-open-link" href="https://www.google.com/maps/search/?api=1&query=<%= mapQuery %>" target="_blank" rel="noopener">
                            Open map
                        </a>
                    </div>
                    <div class="map-preview">
                        <iframe
                            title="Map preview for <%= listing.title %>"
                            src="https://maps.google.com/maps?q=<%= mapQuery %>&output=embed"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </section>
            </div>

            <div class="col-10 offset-1 mt-5">
                <hr class="review-divider">
                <section class="review-section">
                <% const reviewCount = listing.reviews ? listing.reviews.length : 0; %>
                <% const reviewTotal = reviewCount ? listing.reviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) : 0; %>
                <% const reviewAverage = reviewCount ? (reviewTotal / reviewCount).toFixed(1) : 'New'; %>
                <div class="review-summary">
                    <div>
                        <h3><%= reviewAverage %> · <%= reviewCount %> <%= reviewCount === 1 ? 'review' : 'reviews' %></h3>
                        <p><%= reviewCount >= 3 ? 'Guests love this place.' : 'Average rating will appear after 3 reviews.' %></p>
                    </div>
                    <div class="review-score-badge">
                        <i class="fa-solid fa-star"></i>
                        <span><%= reviewAverage %></span>
                    </div>
                </div>

                <h4 class="review-form-title">Leave a Review</h4>
                <form method="POST" action="/listings/<%= listing._id %>/reviews" class="review-form">
                    <div class="review-form-grid">
                        <div>
                            <label for="author" class="form-label">Your name</label>
                            <input name="review[author]" type="text" class="form-control" id="author" placeholder="Enter your name" required>
                        </div>
                        <div>
                            <label for="rating" class="form-label">Rating</label>
                            <select class="form-select" id="rating" name="review[rating]" required>
                                <option value="5">★★★★★ - Excellent</option>
                                <option value="4">★★★★☆ - Good</option>
                                <option value="3">★★★☆☆ - Average</option>
                                <option value="2">★★☆☆☆ - Poor</option>
                                <option value="1">★☆☆☆☆ - Bad</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" class="form-control" id="comment" rows="4" placeholder="Share what stood out about your stay" required></textarea>
                    </div>
                    <button class="btn review-submit-btn" type="submit">
                        <i class="fa-regular fa-star"></i>
                        Submit review
                    </button>
                </form>

                <% if (listing.reviews && listing.reviews.length) { %>
                    <hr>
                    <div class="review-list-heading">
                        <h4>Guest reviews</h4>
                    </div>
                    <div class="review-grid">
                        <% listing.reviews.forEach((review)=> { %>
                            <% const stars = '★★★★★'.slice(0, Number(review.rating || 0)); %>
                            <% const emptyStars = '☆☆☆☆☆'.slice(0, 5 - Number(review.rating || 0)); %>
                            <article class="review-item">
                                <div class="review-author">
                                    <div class="review-avatar"><%= (review.author || 'G').trim().charAt(0).toUpperCase() %></div>
                                    <div>
                                        <h5><%= review.author || 'Guest' %></h5>
                                        <p><%= review.createdAt ? review.createdAt.toDateString() : 'Recently' %></p>
                                    </div>
                                </div>
                                <div class="review-stars"><%= stars %><span><%= emptyStars %></span></div>
                                <p class="review-comment"><%= review.comment %></p>
                                <form method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>/delete">
                                    <button class="btn btn-sm btn-outline-danger review-delete-btn">Delete</button>
                                </form>
                            </article>
                        <% }) %>
                    </div>
                            <% } %>
                </section>
            </div>
        </div>
        <% } else { %>
            <div class="row mt-5">
                <div class="col-8 offset-2">
                    <div class="alert alert-danger">Listing not found.</div>
                </div>
            </div>
            <% } %>
