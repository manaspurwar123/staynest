<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body>
    <!-- Body content goes here -->
</body>

</html>

<body>
    <%- include("../includes/navbar.ejs") %>

        <!-- AUTH_MARKER_v1 -->
        <!-- Auth button positioned absolutely in navbar area -->
        <div style="position: fixed; top: 12px; right: 20px; z-index: 100;">
            <button class="btn auth-btn-trigger" data-bs-toggle="modal" data-bs-target="#authModal">
                <i class="fa-solid fa-circle-user"></i> Log in / Sign up
            </button>
        </div>

        <!-- Auth modal: Sign up / Log in -->
        <div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-md">
                <div class="modal-content auth-modal-content">
                    <div class="modal-header auth-modal-header">
                        <h5 class="modal-title" id="authModalLabel">Log in or sign up</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body auth-modal-body">
                        <ul class="nav nav-tabs auth-nav-tabs" id="authTab" role="tablist">
                            <li class="nav-item auth-nav-item" role="presentation">
                                <button class="nav-link auth-nav-link active" id="login-tab" data-bs-toggle="tab"
                                    data-bs-target="#login" type="button" role="tab">Log in</button>
                            </li>
                            <li class="nav-item auth-nav-item" role="presentation">
                                <button class="nav-link auth-nav-link" id="signup-tab" data-bs-toggle="tab"
                                    data-bs-target="#signup" type="button" role="tab">Sign up</button>
                            </li>
                        </ul>
                        <div class="tab-content auth-tab-content">
                            <div class="tab-pane fade show active" id="login" role="tabpanel">
                                <form method="POST" action="/login" class="auth-form">
                                    <div class="mb-4">
                                        <input name="email" type="email" class="form-control auth-input"
                                            placeholder="Email address" required>
                                    </div>
                                    <div class="mb-4">
                                        <input name="password" type="password" class="form-control auth-input"
                                            placeholder="Password" required>
                                    </div>
                                    <button type="submit" class="btn w-100 auth-btn-submit">Continue</button>
                                    <div class="auth-form-footer mt-3 text-center">
                                        <small class="text-muted">We'll call or text you to confirm your number.</small>
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="signup" role="tabpanel">
                                <form method="POST" action="/register" class="auth-form">
                                    <div class="mb-4">
                                        <input name="email" type="email" class="form-control auth-input"
                                            placeholder="Email address" required>
                                    </div>
                                    <div class="mb-4">
                                        <input name="password" type="password" class="form-control auth-input"
                                            placeholder="Password (min 6 chars)" required minlength="6">
                                    </div>
                                    <button type="submit" class="btn w-100 auth-btn-submit">Create account</button>
                                    <div class="auth-form-footer mt-3 text-center">
                                        <small class="text-muted">You'll use this email to log in to your
                                            account.</small>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container">
            <%- body %>
        </div>

        <%- include("../includes/footer.ejs") %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
</body>

</html>