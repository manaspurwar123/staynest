<!-- Auth modal: Sign up / Log in -->
<div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content auth-modal-content">
            <div class="modal-header auth-modal-header">
                <div class="auth-brand-logo"><i class="fa-regular fa-compass"></i></div>
                <h5 class="modal-title" id="authModalLabel">Log in or sign up</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body auth-modal-body">
                <ul class="nav nav-tabs auth-nav-tabs" id="authTab" role="tablist">
                    <li class="nav-item auth-nav-item" role="presentation">
                        <button class="nav-link auth-nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login"
                            type="button" role="tab">Log in</button>
                    </li>
                    <li class="nav-item auth-nav-item" role="presentation">
                        <button class="nav-link auth-nav-link" id="signup-tab" data-bs-toggle="tab" data-bs-target="#signup"
                            type="button" role="tab">Sign up</button>
                    </li>
                </ul>
                <div class="tab-content auth-tab-content">
                    <div class="tab-pane fade show active" id="login" role="tabpanel">
                        <form method="POST" action="/login" class="auth-form">
                            <div class="mb-4">
                                <input name="email" type="email" class="form-control auth-input" placeholder="Email address" required>
                            </div>
                            <div class="mb-4">
                                <input name="password" type="password" class="form-control auth-input" placeholder="Password" required>
                            </div>
                            <button type="submit" class="btn w-100 auth-btn-submit">Continue</button>
                            <div class="auth-form-footer mt-3 text-center">
                                <small class="text-muted">Log in with your saved email and password.</small>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane fade" id="signup" role="tabpanel">
                        <form method="POST" action="/register" class="auth-form">
                            <div class="mb-4">
                                <input name="name" type="text" class="form-control auth-input" placeholder="Full name" required minlength="2">
                            </div>
                            <div class="mb-4">
                                <input name="email" type="email" class="form-control auth-input" placeholder="Email address" required>
                            </div>
                            <div class="mb-4">
                                <input name="password" type="password" class="form-control auth-input" placeholder="Password (min 6 chars)" required minlength="6">
                            </div>
                            <button type="submit" class="btn w-100 auth-btn-submit">Create account</button>
                            <div class="auth-form-footer mt-3 text-center">
                                <small class="text-muted">Your name, email and password will be saved in the database.</small>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
